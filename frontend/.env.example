# Vite dev/preview port
FRONTEND_PORT=5003

# Backend API base URL. Optional — when unset, the frontend targets port 8003 on
# whatever host served the page, which is what you want when reaching the dev server
# over a LAN or WSL address. Set this only to point at a backend on another host.
# VITE_API_BASE=http://127.0.0.1:8003
